{
  "name": "xinyao",
  "version": "5.0.6",
  "main": "dist-electron/main/index.js",
  "description": "AI数字人视频系统",
  "author": "ModStartLib",
  "license": "Apache-2.0",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/clean-build-artifacts.cjs && vite build && npm run audit:bundle",
    "build:dev": "node scripts/clean-build-artifacts.cjs && vite build --mode development",
    "preview": "vite preview",
    "dev:all": "npm run dev:electron",
    "dev:win": "npm run dev:electron",
    "dev:electron": "concurrently -k \"node scripts/dev-server.cjs external\" \"node scripts/dev-electron.cjs\"",
    "prepare-package": "node scripts/prepare-runtime-package.cjs",
    "build:win": "npm run prepare-package && npm run build && node scripts/build-resource-artifacts.cjs && electron-builder --win --x64 && node scripts/fix-latest-yml.cjs && node scripts/assemble-release-artifacts.cjs",
    "build:win:only": "electron-builder --win --x64",
    "build:mac": "npm run prepare-package && npm run typecheck && vite build && electron-builder --mac",
    "postinstall": "node scripts/setup-desktop.cjs",
    "release:clean": "node scripts/prepare-release-safe.cjs",
    "release:prepare": "npm run build:win && npm run release:clean",
    "check:runtime": "node scripts/check-runtime-resources.cjs",
    "init:local": "node scripts/init-local-config.cjs",
    "export:source": "node scripts/export-source.cjs",
    "start:server": "node user-server/server.js",
    "test": "node --test tests/*.test.cjs",
    "audit:source": "node scripts/audit-source.cjs",
    "audit:bundle": "node scripts/audit-build-secrets.cjs",
    "start:desktop": "node scripts/start-built-desktop.cjs"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/remote": "^2.1.2",
    "@gradio/client": "^1.5.2",
    "ali-oss": "^6.23.0",
    "archiver": "^7.0.0",
    "axios": "^1.7.2",
    "better-sqlite3": "^12.6.0",
    "bufferutil": "^4.0.8",
    "canvg": "^4.0.2",
    "chardet": "^2.0.0",
    "concurrently": "^8.2.2",
    "date-and-time": "^4.4.0",
    "date-fns": "^4.1.0",
    "dayjs": "1.11.19",
    "dompurify": "^3.1.6",
    "electron-context-menu": "^3.6.1",
    "electron-log": "^5.1.5",
    "electron-updater": "^6.3.4",
    "file-saver": "^2.0.5",
    "fix-path": "^4.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "4.0.6",
    "fs-extra": "^11.2.0",
    "iconv-lite": "^0.6.3",
    "js-base64": "^3.7.8",
    "jszip": "^3.10.1",
    "lodash-es": "4.18.1",
    "markdown-it": "^14.1.0",
    "mddir": "^1.1.1",
    "moment": "^2.30.1",
    "node-cron": "^3.0.3",
    "node-stream-zip": "^1.15.0",
    "os-utils": "^0.0.14",
    "pdfkit": "^0.15.0",
    "pinia": "^3.0.4",
    "playwright": "^1.49.1",
    "qrcode": "^1.5.4",
    "semver": "^7.6.2",
    "sharp": "^0.33.4",
    "showdown": "^2.1.0",
    "spark-md5": "^3.0.2",
    "svg2img": "^1.0.0-beta.2",
    "svgtofont": "^4.1.1",
    "tailwindcss": "^3.4.4",
    "tiny-emitter": "^2.1.0",
    "utf-8-validate": "^6.0.3",
    "uuid": "^10.0.0",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "vue-timeago3": "^2.3.2",
    "wavesurfer.js": "^7.12.5",
    "ws": "^8.17.0",
    "xgplayer": "^3.0.24",
    "yauzl": "^3.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "3.6.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/dompurify": "^3.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "autoprefixer": "^10.4.27",
    "electron": "^29.4.6",
    "electron-builder": "^25.1.8",
    "ignore": "5.3.2",
    "less": "^4.2.0",
    "postcss": "^8.5.9",
    "sass-embedded": "^1.99.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue": "^3.4.27",
    "vue-tsc": "^2.0.19",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
